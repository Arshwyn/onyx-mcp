# Copy to .env and fill in. Never commit .env.

# Supabase project that holds the Onyx tables
SUPABASE_URL=https://<project-ref>.supabase.co
# Service role key (bypasses RLS; keep private)
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Comma-separated client names (lowercase letters, digits, hyphens)
OAUTH_CLIENTS=<client-name>

# One block per client. <CLIENT-NAME> is the name uppercased, "-" -> "_".
OAUTH_CLIENT_<CLIENT-NAME>_ID=<client-id>
# generate: openssl rand -hex 32
OAUTH_CLIENT_<CLIENT-NAME>_SECRET=<client-secret>
# Supabase auth user UUID whose data this client may access
OAUTH_CLIENT_<CLIENT-NAME>_USER_ID=<supabase-user-uuid>
# The connector's callback URL (logged on first authorize attempt)
OAUTH_CLIENT_<CLIENT-NAME>_REDIRECT_URI=<claude-callback-url>

# Optional (default 10000)
# PORT=10000

# Optional: exact origins allowed to call this server from a browser
# (comma-separated, no paths or wildcards). Empty disables CORS.
# Example: https://app.example.com
# CORS_ALLOWED_ORIGINS=
